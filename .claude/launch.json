{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook", "--", "--no-open", "--quiet"],
      "port": 6006
    },
    {
      "name": "story-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "story-ui"],
      "port": 4001
    },
    {
      "name": "mintlify",
      "runtimeExecutable": "mint",
      "runtimeArgs": ["dev", "--port", "3111"],
      "port": 3111,
      "cwd": "mintlify"
    }
  ]
}
